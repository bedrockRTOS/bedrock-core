      - "${CC} ${CFLAGS} -Iports/lwip -Iports/lwip/upstream/src/include examples/test_net.c -o ${@}"

  riscv32-test_net.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} -Iports/lwip -Iports/lwip/upstream/src/include examples/test_net.c -o ${@}"

  test_net_qemu.o:
    cmds:
      - "${CC} ${CFLAGS} -Iports/lwip -Iports/lwip/upstream/src/include examples/test_net_qemu.c -o ${@}"

  riscv32-test_net_qemu.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} -Iports/lwip -Iports/lwip/upstream/src/include examples/test_net_qemu.c -o ${@}"

  host-test_net.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} -Iports/lwip -Iports/lwip/upstream/src/include examples/test_net.c -o ${@}"

  rp2040-test_net.o:
    cmds:
      - "${CC} ${M0_CFLAGS} -Iports/lwip -Iports/lwip/upstream/src/include examples/test_net.c -o ${@}"

  test_net.elf:
    deps: [test_net.o, br_libc.o, liblwip.a, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_net.o br_libc.o lm3s-board.o -L. -Wl,--start-group -llwip -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_net_riscv32.elf:
    deps: [riscv32-test_net.o, riscv32-br_libc.o, riscv32-board.o, liblwip_riscv32.a, libbedrock_kernel_riscv32.a, libbedrock_hal_riscv32.a, libbedrock_lib_riscv32.a]
    cmds:
      - "${RV_CC} ${RV_LDFLAGS} riscv32-test_net.o riscv32-br_libc.o riscv32-board.o -L. -Wl,--start-group -llwip_riscv32 -lbedrock_hal_riscv32 -lbedrock_kernel_riscv32 -lbedrock_lib_riscv32 -Wl,--end-group -lgcc -o ${@}"

  test_net_qemu.elf:
    deps: [test_net_qemu.o, br_libc.o, liblwip.a, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_net_qemu.o br_libc.o lm3s-board.o -L. -Wl,--start-group -llwip -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_net_qemu_riscv32.elf:
    deps: [riscv32-test_net_qemu.o, riscv32-br_libc.o, riscv32-board.o, liblwip_riscv32.a, libbedrock_kernel_riscv32.a, libbedrock_hal_riscv32.a, libbedrock_lib_riscv32.a]
    cmds:
      - "${RV_CC} ${RV_LDFLAGS} riscv32-test_net_qemu.o riscv32-br_libc.o riscv32-board.o -L. -Wl,--start-group -llwip_riscv32 -lbedrock_hal_riscv32 -lbedrock_kernel_riscv32 -lbedrock_lib_riscv32 -Wl,--end-group -lgcc -o ${@}"

  test_net_host:
    deps: [host-test_net.o, liblwip_host.a, libbedrock_kernel_host.a, libbedrock_hal_host.a, host-br_netif_mock.o, host-br_shell.o, host-br_console.o]
    cmds:
      - "${HOST_CC} ${HOST_LDFLAGS} host-test_net.o host-br_netif_mock.o host-br_shell.o host-br_console.o -L. -Wl,--start-group -llwip_host -lbedrock_kernel_host -lbedrock_hal_host -Wl,--end-group -o ${@}"

  test-net-host:
    deps: [test_net_host]
    cmds:
      - "timeout 5 ./test_net_host; true"

  test_net_rp2040.elf:
    deps: [rp2040-test_net.o, rp2040-br_libc.o, rp2040-boot2_crc.o, liblwip_rp2040.a, libbedrock_kernel_rp2040.a, libbedrock_hal_rp2040.a, libbedrock_lib_rp2040.a]
    cmds:
      - "${CC} ${M0_LDFLAGS} rp2040-test_net.o rp2040-br_libc.o rp2040-boot2_crc.o -L. -Wl,--start-group -llwip_rp2040 -lbedrock_hal_rp2040 -lbedrock_kernel_rp2040 -lbedrock_lib_rp2040 -Wl,--end-group -lgcc -o ${@}"

  net_udp_echo.o:
    cmds:
      - "${CC} ${CFLAGS} -Iports/lwip -Iports/lwip/upstream/src/include examples/net_udp_echo.c -o ${@}"

  riscv32-net_udp_echo.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} -Iports/lwip -Iports/lwip/upstream/src/include examples/net_udp_echo.c -o ${@}"

  bedrock_udp_echo.elf:
    deps: [net_udp_echo.o, br_libc.o, liblwip.a, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} net_udp_echo.o br_libc.o lm3s-board.o -L. -Wl,--start-group -llwip -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  bedrock_udp_echo_riscv32.elf:
    deps: [riscv32-net_udp_echo.o, riscv32-br_libc.o, riscv32-board.o, liblwip_riscv32.a, libbedrock_kernel_riscv32.a, libbedrock_hal_riscv32.a, libbedrock_lib_riscv32.a]
    cmds:
      - "${RV_CC} ${RV_LDFLAGS} riscv32-net_udp_echo.o riscv32-br_libc.o riscv32-board.o -L. -Wl,--start-group -llwip_riscv32 -lbedrock_hal_riscv32 -lbedrock_kernel_riscv32 -lbedrock_lib_riscv32 -Wl,--end-group -lgcc -o ${@}"

  run-udp-echo:
    deps: [bedrock_udp_echo.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -nographic -nic user,model=stellaris,hostfwd=udp::7777-:7 -kernel bedrock_udp_echo.elf"

  run-udp-echo-riscv32:
    deps: [bedrock_udp_echo_riscv32.elf]
    cmds:
      - "qemu-system-riscv32 -M virt -bios none -nographic -global virtio-mmio.force-legacy=false -netdev user,id=n0,hostfwd=udp::7777-:7 -device virtio-net-device,netdev=n0 -kernel bedrock_udp_echo_riscv32.elf"

