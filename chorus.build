variables:
  CC: "arm-none-eabi-gcc"
  AR: "arm-none-eabi-ar"
  OBJCOPY: "arm-none-eabi-objcopy"
  CFLAGS: "-c -Wall -Wextra -Werror -Os -ffreestanding -ffunction-sections -fdata-sections -std=c11 -mcpu=cortex-m3 -mthumb -mfloat-abi=soft -Iinclude -Ilib"
  LDFLAGS: "-nostdlib -Wl,--gc-sections -Tboards/qemu-cortex-m3/linker.ld -mcpu=cortex-m3 -mthumb"
  HOST_CC: "gcc"
  HOST_CFLAGS: "-c -Wall -Wextra -Werror -Os -std=c11 -D_DEFAULT_SOURCE -DBR_HOST_TEST -Iinclude -Ilib"
  HOST_LDFLAGS: ""
  STM32F1_LDFLAGS: "-nostdlib -Wl,--gc-sections -Tboards/stm32f103c8-bluepill/linker.ld -mcpu=cortex-m3 -mthumb"
  M0_CFLAGS: "-c -Wall -Wextra -Werror -Os -ffreestanding -ffunction-sections -fdata-sections -std=c11 -mcpu=cortex-m0plus -mthumb -mfloat-abi=soft -Iinclude -Ilib"
  M0_LDFLAGS: "-nostdlib -Wl,--gc-sections -Tboards/rpi-pico/linker.ld -mcpu=cortex-m0plus -mthumb"
  TOOL_CFLAGS: "-Wall -Wextra -Werror -Os -std=c11"
  RV_CC: "riscv64-elf-gcc"
  RV_AR: "riscv64-elf-ar"
  RV_CFLAGS: "-c -Wall -Wextra -Werror -Os -ffreestanding -ffunction-sections -fdata-sections -std=c11 -march=rv32imac_zicsr -mabi=ilp32 -DBR_HAL_SYS_CLOCK_HZ=10000000 -Iinclude -Ilib"
  RV_LDFLAGS: "-nostdlib -Wl,--gc-sections -Wl,--no-warn-rwx-segments -Tboards/qemu-riscv32-virt/linker.ld -march=rv32imac_zicsr -mabi=ilp32"

targets:
  all:
    deps: [bedrock_example.elf]

  br_sched.o:
    cmds:
      - "${CC} ${CFLAGS} kernel/br_sched.c -o ${@}"

  br_time.o:
    cmds:
      - "${CC} ${CFLAGS} kernel/br_time.c -o ${@}"

  br_task.o:
    cmds:
      - "${CC} ${CFLAGS} kernel/br_task.c -o ${@}"

  br_ipc.o:
    cmds:
      - "${CC} ${CFLAGS} kernel/br_ipc.c -o ${@}"

  br_panic.o:
    cmds:
      - "${CC} ${CFLAGS} kernel/br_panic.c -o ${@}"

  br_hal_timer.o:
    cmds:
      - "${CC} ${CFLAGS} arch/arm-cortex-m/br_hal_timer.c -o ${@}"

  br_hal_context.o:
    cmds:
      - "${CC} ${CFLAGS} arch/arm-cortex-m/br_hal_context.c -o ${@}"

  br_hal_uart.o:
    cmds:
      - "${CC} ${CFLAGS} boards/qemu-cortex-m3/br_hal_uart.c -o ${@}"

  startup.o:
    cmds:
      - "${CC} ${CFLAGS} arch/arm-cortex-m/startup.c -o ${@}"

  br_pool.o:
    cmds:
      - "${CC} ${CFLAGS} lib/br_pool.c -o ${@}"

  br_string.o:
    cmds:
      - "${CC} ${CFLAGS} -fno-tree-loop-distribute-patterns lib/br_string.c -o ${@}"

  main.o:
    cmds:
      - "${CC} ${CFLAGS} examples/main.c -o ${@}"

  test_task_delete.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_task_delete.c -o ${@}"

  test_scheduler.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_scheduler.c -o ${@}"

  test_semaphore.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_semaphore.c -o ${@}"

  test_mutex.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_mutex.c -o ${@}"

  test_mqueue.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_mqueue.c -o ${@}"

  test_sleep_list.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_sleep_list.c -o ${@}"

  test_pool.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_pool.c -o ${@}"

  libbedrock_kernel.a:
    deps: [br_sched.o, br_time.o, br_task.o, br_ipc.o, br_panic.o]
    cmds:
      - "${AR} rcs ${@} ${^}"

  libbedrock_hal.a:
    deps: [br_hal_timer.o, br_hal_context.o, br_hal_uart.o, startup.o]
    cmds:
      - "${AR} rcs ${@} ${^}"

  libbedrock_lib.a:
    deps: [br_pool.o, br_string.o]
    cmds:
      - "${AR} rcs ${@} ${^}"

  bedrock_example.elf:
    deps: [main.o, libbedrock_kernel.a, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} main.o -L. -lbedrock_hal -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  test_task_delete.elf:
    deps: [test_task_delete.o, libbedrock_kernel.a, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_task_delete.o -L. -lbedrock_hal -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  test_scheduler.elf:
    deps: [test_scheduler.o, libbedrock_kernel.a, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_scheduler.o -L. -lbedrock_hal -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  test_semaphore.elf:
    deps: [test_semaphore.o, libbedrock_kernel.a, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_semaphore.o -L. -lbedrock_hal -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  test_mutex.elf:
    deps: [test_mutex.o, libbedrock_kernel.a, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_mutex.o -L. -lbedrock_hal -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  test_mqueue.elf:
    deps: [test_mqueue.o, libbedrock_kernel.a, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_mqueue.o -L. -lbedrock_hal -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  test_sleep_list.elf:
    deps: [test_sleep_list.o, libbedrock_kernel.a, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_sleep_list.o -L. -lbedrock_hal -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  test_pool.elf:
    deps: [test_pool.o, libbedrock_kernel.a, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_pool.o -L. -lbedrock_hal -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  run:
    deps: [bedrock_example.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel bedrock_example.elf -nographic"

  test:
    deps: [test_task_delete.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_task_delete.elf -nographic"

  test-scheduler:
    deps: [test_scheduler.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_scheduler.elf -nographic"

  test-semaphore:
    deps: [test_semaphore.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_semaphore.elf -nographic"

  test-mutex:
    deps: [test_mutex.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_mutex.elf -nographic"

  test-mqueue:
    deps: [test_mqueue.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_mqueue.elf -nographic"

  test-sleep-list:
    deps: [test_sleep_list.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_sleep_list.elf -nographic"

  test-pool:
    deps: [test_pool.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_pool.elf -nographic"

  build-tools:
    cmds:
      - "zig build --build-file 3rd/tools/kconfig/build.zig --prefix 3rd/tools/kconfig/zig-out -Doptimize=ReleaseFast"

  configure:
    cmds:
      - "3rd/tools/kconfig/zig-out/bin/genconfig"

  defconfig:
    cmds:
      - "3rd/tools/kconfig/zig-out/bin/defconfig boards/qemu-cortex-m3/defconfig"

  menuconfig:
    cmds:
      - "3rd/tools/kconfig/zig-out/bin/menuconfig 0</dev/tty"

  host-br_sched.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} kernel/br_sched.c -o ${@}"

  host-br_time.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} kernel/br_time.c -o ${@}"

  host-br_task.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} kernel/br_task.c -o ${@}"

  host-br_ipc.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} kernel/br_ipc.c -o ${@}"

  host-br_panic.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} kernel/br_panic.c -o ${@}"

  host-br_hal_context.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} arch/host-x86-64/br_hal_context.c -o ${@}"

  host-br_hal_timer.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} arch/host-x86-64/br_hal_timer.c -o ${@}"

  host-br_hal_uart.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} arch/host-x86-64/br_hal_uart.c -o ${@}"

  host-main.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} examples/main.c -o ${@}"

  host-test_task_delete.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} examples/test_task_delete.c -o ${@}"

  host-test_scheduler.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} examples/test_scheduler.c -o ${@}"

  host-test_semaphore.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} examples/test_semaphore.c -o ${@}"

  host-test_mutex.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} examples/test_mutex.c -o ${@}"

  host-test_mqueue.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} examples/test_mqueue.c -o ${@}"

  host-test_sleep_list.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} examples/test_sleep_list.c -o ${@}"

  host-test_pool.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} examples/test_pool.c -o ${@}"

  libbedrock_kernel_host.a:
    deps: [host-br_sched.o, host-br_time.o, host-br_task.o, host-br_ipc.o, host-br_panic.o]
    cmds:
      - "ar rcs ${@} ${^}"

  libbedrock_hal_host.a:
    deps: [host-br_hal_context.o, host-br_hal_timer.o, host-br_hal_uart.o]
    cmds:
      - "ar rcs ${@} ${^}"

  bedrock_example_host:
    deps: [host-main.o, libbedrock_kernel_host.a, libbedrock_hal_host.a]
    cmds:
      - "${HOST_CC} ${HOST_LDFLAGS} host-main.o -L. -lbedrock_kernel_host -lbedrock_hal_host -o ${@}"

  test_task_delete_host:
    deps: [host-test_task_delete.o, libbedrock_kernel_host.a, libbedrock_hal_host.a]
    cmds:
      - "${HOST_CC} ${HOST_LDFLAGS} host-test_task_delete.o -L. -lbedrock_kernel_host -lbedrock_hal_host -o ${@}"

  test_scheduler_host:
    deps: [host-test_scheduler.o, libbedrock_kernel_host.a, libbedrock_hal_host.a]
    cmds:
      - "${HOST_CC} ${HOST_LDFLAGS} host-test_scheduler.o -L. -lbedrock_kernel_host -lbedrock_hal_host -o ${@}"

  test_semaphore_host:
    deps: [host-test_semaphore.o, libbedrock_kernel_host.a, libbedrock_hal_host.a]
    cmds:
      - "${HOST_CC} ${HOST_LDFLAGS} host-test_semaphore.o -L. -lbedrock_kernel_host -lbedrock_hal_host -o ${@}"

  test_mutex_host:
    deps: [host-test_mutex.o, libbedrock_kernel_host.a, libbedrock_hal_host.a]
    cmds:
      - "${HOST_CC} ${HOST_LDFLAGS} host-test_mutex.o -L. -lbedrock_kernel_host -lbedrock_hal_host -o ${@}"

  test_mqueue_host:
    deps: [host-test_mqueue.o, libbedrock_kernel_host.a, libbedrock_hal_host.a]
    cmds:
      - "${HOST_CC} ${HOST_LDFLAGS} host-test_mqueue.o -L. -lbedrock_kernel_host -lbedrock_hal_host -o ${@}"

  test_sleep_list_host:
    deps: [host-test_sleep_list.o, libbedrock_kernel_host.a, libbedrock_hal_host.a]
    cmds:
      - "${HOST_CC} ${HOST_LDFLAGS} host-test_sleep_list.o -L. -lbedrock_kernel_host -lbedrock_hal_host -o ${@}"

  host-br_pool.o:
    cmds:
      - "${HOST_CC} ${HOST_CFLAGS} lib/br_pool.c -o ${@}"

  test_pool_host:
    deps: [host-test_pool.o, host-br_pool.o, host-br_hal_uart.o]
    cmds:
      - "${HOST_CC} ${HOST_LDFLAGS} host-test_pool.o host-br_pool.o host-br_hal_uart.o -o ${@}"

  host:
    deps: [bedrock_example_host, test_task_delete_host, test_scheduler_host, test_semaphore_host, test_mutex_host, test_mqueue_host, test_sleep_list_host, test_pool_host]

  run-host:
    deps: [bedrock_example_host]
    cmds:
      - "timeout 5 ./bedrock_example_host; true"

  test-host:
    deps: [test_task_delete_host]
    cmds:
      - "timeout 5 ./test_task_delete_host; true"

  test-scheduler-host:
    deps: [test_scheduler_host]
    cmds:
      - "timeout 5 ./test_scheduler_host; true"

  test-semaphore-host:
    deps: [test_semaphore_host]
    cmds:
      - "timeout 5 ./test_semaphore_host; true"

  test-mutex-host:
    deps: [test_mutex_host]
    cmds:
      - "timeout 5 ./test_mutex_host; true"

  test-mqueue-host:
    deps: [test_mqueue_host]
    cmds:
      - "timeout 5 ./test_mqueue_host; true"

  test-sleep-list-host:
    deps: [test_sleep_list_host]
    cmds:
      - "timeout 5 ./test_sleep_list_host; true"

  test-pool-host:
    deps: [test_pool_host]
    cmds:
      - "timeout 5 ./test_pool_host; true"

  riscv32-br_sched.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} kernel/br_sched.c -o ${@}"

  riscv32-br_time.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} kernel/br_time.c -o ${@}"

  riscv32-br_task.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} kernel/br_task.c -o ${@}"

  riscv32-br_ipc.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} kernel/br_ipc.c -o ${@}"

  riscv32-br_panic.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} kernel/br_panic.c -o ${@}"

  riscv32-br_hal_timer.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} arch/riscv32/br_hal_timer.c -o ${@}"

  riscv32-br_hal_context.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} arch/riscv32/br_hal_context.c -o ${@}"

  riscv32-br_hal_uart.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} arch/riscv32/br_hal_uart.c -o ${@}"

  riscv32-startup.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} arch/riscv32/startup.c -o ${@}"

  riscv32-br_pool.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} lib/br_pool.c -o ${@}"

  riscv32-br_string.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} -fno-tree-loop-distribute-patterns lib/br_string.c -o ${@}"

  riscv32-main.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} examples/main.c -o ${@}"

  riscv32-test_task_delete.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} examples/test_task_delete.c -o ${@}"

  riscv32-test_scheduler.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} examples/test_scheduler.c -o ${@}"

  riscv32-test_semaphore.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} examples/test_semaphore.c -o ${@}"

  riscv32-test_mutex.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} examples/test_mutex.c -o ${@}"

  riscv32-test_mqueue.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} examples/test_mqueue.c -o ${@}"

  riscv32-test_sleep_list.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} examples/test_sleep_list.c -o ${@}"

  riscv32-test_pool.o:
    cmds:
      - "${RV_CC} ${RV_CFLAGS} examples/test_pool.c -o ${@}"

  libbedrock_kernel_riscv32.a:
    deps: [riscv32-br_sched.o, riscv32-br_time.o, riscv32-br_task.o, riscv32-br_ipc.o, riscv32-br_panic.o]
    cmds:
      - "${RV_AR} rcs ${@} ${^}"

  libbedrock_hal_riscv32.a:
    deps: [riscv32-br_hal_timer.o, riscv32-br_hal_context.o, riscv32-br_hal_uart.o, riscv32-startup.o]
    cmds:
      - "${RV_AR} rcs ${@} ${^}"

  libbedrock_lib_riscv32.a:
    deps: [riscv32-br_pool.o, riscv32-br_string.o]
    cmds:
      - "${RV_AR} rcs ${@} ${^}"

  bedrock_example_riscv32.elf:
    deps: [riscv32-main.o, libbedrock_kernel_riscv32.a, libbedrock_hal_riscv32.a, libbedrock_lib_riscv32.a]
    cmds:
      - "${RV_CC} ${RV_LDFLAGS} riscv32-main.o -L. -lbedrock_hal_riscv32 -lbedrock_kernel_riscv32 -lbedrock_lib_riscv32 -lgcc -o ${@}"

  test_task_delete_riscv32.elf:
    deps: [riscv32-test_task_delete.o, libbedrock_kernel_riscv32.a, libbedrock_hal_riscv32.a, libbedrock_lib_riscv32.a]
    cmds:
      - "${RV_CC} ${RV_LDFLAGS} riscv32-test_task_delete.o -L. -lbedrock_hal_riscv32 -lbedrock_kernel_riscv32 -lbedrock_lib_riscv32 -lgcc -o ${@}"

  test_scheduler_riscv32.elf:
    deps: [riscv32-test_scheduler.o, libbedrock_kernel_riscv32.a, libbedrock_hal_riscv32.a, libbedrock_lib_riscv32.a]
    cmds:
      - "${RV_CC} ${RV_LDFLAGS} riscv32-test_scheduler.o -L. -lbedrock_hal_riscv32 -lbedrock_kernel_riscv32 -lbedrock_lib_riscv32 -lgcc -o ${@}"

  test_semaphore_riscv32.elf:
    deps: [riscv32-test_semaphore.o, libbedrock_kernel_riscv32.a, libbedrock_hal_riscv32.a, libbedrock_lib_riscv32.a]
    cmds:
      - "${RV_CC} ${RV_LDFLAGS} riscv32-test_semaphore.o -L. -lbedrock_hal_riscv32 -lbedrock_kernel_riscv32 -lbedrock_lib_riscv32 -lgcc -o ${@}"

  test_mutex_riscv32.elf:
    deps: [riscv32-test_mutex.o, libbedrock_kernel_riscv32.a, libbedrock_hal_riscv32.a, libbedrock_lib_riscv32.a]
    cmds:
      - "${RV_CC} ${RV_LDFLAGS} riscv32-test_mutex.o -L. -lbedrock_hal_riscv32 -lbedrock_kernel_riscv32 -lbedrock_lib_riscv32 -lgcc -o ${@}"

  test_mqueue_riscv32.elf:
    deps: [riscv32-test_mqueue.o, libbedrock_kernel_riscv32.a, libbedrock_hal_riscv32.a, libbedrock_lib_riscv32.a]
    cmds:
      - "${RV_CC} ${RV_LDFLAGS} riscv32-test_mqueue.o -L. -lbedrock_hal_riscv32 -lbedrock_kernel_riscv32 -lbedrock_lib_riscv32 -lgcc -o ${@}"

  test_sleep_list_riscv32.elf:
    deps: [riscv32-test_sleep_list.o, libbedrock_kernel_riscv32.a, libbedrock_hal_riscv32.a, libbedrock_lib_riscv32.a]
    cmds:
      - "${RV_CC} ${RV_LDFLAGS} riscv32-test_sleep_list.o -L. -lbedrock_hal_riscv32 -lbedrock_kernel_riscv32 -lbedrock_lib_riscv32 -lgcc -o ${@}"

  test_pool_riscv32.elf:
    deps: [riscv32-test_pool.o, libbedrock_kernel_riscv32.a, libbedrock_hal_riscv32.a, libbedrock_lib_riscv32.a]
    cmds:
      - "${RV_CC} ${RV_LDFLAGS} riscv32-test_pool.o -L. -lbedrock_hal_riscv32 -lbedrock_kernel_riscv32 -lbedrock_lib_riscv32 -lgcc -o ${@}"

  riscv32:
    deps: [bedrock_example_riscv32.elf, test_task_delete_riscv32.elf, test_scheduler_riscv32.elf, test_semaphore_riscv32.elf, test_mutex_riscv32.elf, test_mqueue_riscv32.elf, test_sleep_list_riscv32.elf, test_pool_riscv32.elf]

  run-riscv32:
    deps: [bedrock_example_riscv32.elf]
    cmds:
      - "qemu-system-riscv32 -M virt -bios none -nographic -kernel bedrock_example_riscv32.elf"

  test-task-delete-riscv32:
    deps: [test_task_delete_riscv32.elf]
    cmds:
      - "qemu-system-riscv32 -M virt -bios none -nographic -kernel test_task_delete_riscv32.elf"

  test-scheduler-riscv32:
    deps: [test_scheduler_riscv32.elf]
    cmds:
      - "qemu-system-riscv32 -M virt -bios none -nographic -kernel test_scheduler_riscv32.elf"

  test-semaphore-riscv32:
    deps: [test_semaphore_riscv32.elf]
    cmds:
      - "qemu-system-riscv32 -M virt -bios none -nographic -kernel test_semaphore_riscv32.elf"

  test-mutex-riscv32:
    deps: [test_mutex_riscv32.elf]
    cmds:
      - "qemu-system-riscv32 -M virt -bios none -nographic -kernel test_mutex_riscv32.elf"

  test-mqueue-riscv32:
    deps: [test_mqueue_riscv32.elf]
    cmds:
      - "qemu-system-riscv32 -M virt -bios none -nographic -kernel test_mqueue_riscv32.elf"

  test-sleep-list-riscv32:
    deps: [test_sleep_list_riscv32.elf]
    cmds:
      - "qemu-system-riscv32 -M virt -bios none -nographic -kernel test_sleep_list_riscv32.elf"

  test-pool-riscv32:
    deps: [test_pool_riscv32.elf]
    cmds:
      - "qemu-system-riscv32 -M virt -bios none -nographic -kernel test_pool_riscv32.elf"

  defconfig-riscv32:
    cmds:
      - "3rd/tools/kconfig/zig-out/bin/defconfig boards/qemu-riscv32-virt/defconfig"

  bootcrc:
    cmds:
      - "${HOST_CC} ${TOOL_CFLAGS} tools/bootcrc.c -o ${@}"

  bin2uf2:
    cmds:
      - "${HOST_CC} ${TOOL_CFLAGS} tools/bin2uf2.c -o ${@}"

  rp2040-br_sched.o:
    cmds:
      - "${CC} ${M0_CFLAGS} kernel/br_sched.c -o ${@}"

  rp2040-br_time.o:
    cmds:
      - "${CC} ${M0_CFLAGS} kernel/br_time.c -o ${@}"

  rp2040-br_task.o:
    cmds:
      - "${CC} ${M0_CFLAGS} kernel/br_task.c -o ${@}"

  rp2040-br_ipc.o:
    cmds:
      - "${CC} ${M0_CFLAGS} kernel/br_ipc.c -o ${@}"

  rp2040-br_panic.o:
    cmds:
      - "${CC} ${M0_CFLAGS} kernel/br_panic.c -o ${@}"

  rp2040-br_hal_timer.o:
    cmds:
      - "${CC} ${M0_CFLAGS} arch/arm-cortex-m0plus/br_hal_timer.c -o ${@}"

  rp2040-br_hal_context.o:
    cmds:
      - "${CC} ${M0_CFLAGS} arch/arm-cortex-m0plus/br_hal_context.c -o ${@}"

  rp2040-br_hal_uart.o:
    cmds:
      - "${CC} ${M0_CFLAGS} arch/arm-cortex-m0plus/br_hal_uart.c -o ${@}"

  rp2040-startup.o:
    cmds:
      - "${CC} ${M0_CFLAGS} arch/arm-cortex-m0plus/startup.c -o ${@}"

  rp2040-br_pool.o:
    cmds:
      - "${CC} ${M0_CFLAGS} lib/br_pool.c -o ${@}"

  rp2040-boot2.o:
    cmds:
      - "${CC} ${M0_CFLAGS} boards/rpi-pico/boot2.c -o ${@}"

  rp2040-main.o:
    cmds:
      - "${CC} ${M0_CFLAGS} examples/main.c -o ${@}"

  rp2040-test_task_delete.o:
    cmds:
      - "${CC} ${M0_CFLAGS} examples/test_task_delete.c -o ${@}"

  rp2040-test_scheduler.o:
    cmds:
      - "${CC} ${M0_CFLAGS} examples/test_scheduler.c -o ${@}"

  rp2040-test_semaphore.o:
    cmds:
      - "${CC} ${M0_CFLAGS} examples/test_semaphore.c -o ${@}"

  rp2040-test_mutex.o:
    cmds:
      - "${CC} ${M0_CFLAGS} examples/test_mutex.c -o ${@}"

  rp2040-test_mqueue.o:
    cmds:
      - "${CC} ${M0_CFLAGS} examples/test_mqueue.c -o ${@}"

  rp2040-test_sleep_list.o:
    cmds:
      - "${CC} ${M0_CFLAGS} examples/test_sleep_list.c -o ${@}"

  rp2040-test_pool.o:
    cmds:
      - "${CC} ${M0_CFLAGS} examples/test_pool.c -o ${@}"

  rp2040-br_string.o:
    cmds:
      - "${CC} ${M0_CFLAGS} -fno-tree-loop-distribute-patterns lib/br_string.c -o ${@}"

  rp2040-boot2.bin:
    deps: [rp2040-boot2.o]
    cmds:
      - "${OBJCOPY} -O binary -j .boot2 rp2040-boot2.o ${@}"

  rp2040-boot2_crc.S:
    deps: [rp2040-boot2.bin, bootcrc]
    cmds:
      - "./bootcrc rp2040-boot2.bin ${@}"

  rp2040-boot2_crc.o:
    deps: [rp2040-boot2_crc.S]
    cmds:
      - "${CC} ${M0_CFLAGS} rp2040-boot2_crc.S -o ${@}"

  libbedrock_kernel_rp2040.a:
    deps: [rp2040-br_sched.o, rp2040-br_time.o, rp2040-br_task.o, rp2040-br_ipc.o, rp2040-br_panic.o]
    cmds:
      - "${AR} rcs ${@} ${^}"

  libbedrock_hal_rp2040.a:
    deps: [rp2040-br_hal_timer.o, rp2040-br_hal_context.o, rp2040-br_hal_uart.o, rp2040-startup.o]
    cmds:
      - "${AR} rcs ${@} ${^}"

  libbedrock_lib_rp2040.a:
    deps: [rp2040-br_pool.o, rp2040-br_string.o]
    cmds:
      - "${AR} rcs ${@} ${^}"

  bedrock_example_rp2040.elf:
    deps: [rp2040-main.o, rp2040-boot2_crc.o, libbedrock_kernel_rp2040.a, libbedrock_hal_rp2040.a, libbedrock_lib_rp2040.a]
    cmds:
      - "${CC} ${M0_LDFLAGS} rp2040-main.o rp2040-boot2_crc.o -L. -lbedrock_hal_rp2040 -lbedrock_kernel_rp2040 -lbedrock_lib_rp2040 -lgcc -o ${@}"

  test_task_delete_rp2040.elf:
    deps: [rp2040-test_task_delete.o, rp2040-boot2_crc.o, libbedrock_kernel_rp2040.a, libbedrock_hal_rp2040.a, libbedrock_lib_rp2040.a]
    cmds:
      - "${CC} ${M0_LDFLAGS} rp2040-test_task_delete.o rp2040-boot2_crc.o -L. -lbedrock_hal_rp2040 -lbedrock_kernel_rp2040 -lbedrock_lib_rp2040 -lgcc -o ${@}"

  test_scheduler_rp2040.elf:
    deps: [rp2040-test_scheduler.o, rp2040-boot2_crc.o, libbedrock_kernel_rp2040.a, libbedrock_hal_rp2040.a, libbedrock_lib_rp2040.a]
    cmds:
      - "${CC} ${M0_LDFLAGS} rp2040-test_scheduler.o rp2040-boot2_crc.o -L. -lbedrock_hal_rp2040 -lbedrock_kernel_rp2040 -lbedrock_lib_rp2040 -lgcc -o ${@}"

  test_semaphore_rp2040.elf:
    deps: [rp2040-test_semaphore.o, rp2040-boot2_crc.o, libbedrock_kernel_rp2040.a, libbedrock_hal_rp2040.a, libbedrock_lib_rp2040.a]
    cmds:
      - "${CC} ${M0_LDFLAGS} rp2040-test_semaphore.o rp2040-boot2_crc.o -L. -lbedrock_hal_rp2040 -lbedrock_kernel_rp2040 -lbedrock_lib_rp2040 -lgcc -o ${@}"

  test_mutex_rp2040.elf:
    deps: [rp2040-test_mutex.o, rp2040-boot2_crc.o, libbedrock_kernel_rp2040.a, libbedrock_hal_rp2040.a, libbedrock_lib_rp2040.a]
    cmds:
      - "${CC} ${M0_LDFLAGS} rp2040-test_mutex.o rp2040-boot2_crc.o -L. -lbedrock_hal_rp2040 -lbedrock_kernel_rp2040 -lbedrock_lib_rp2040 -lgcc -o ${@}"

  test_mqueue_rp2040.elf:
    deps: [rp2040-test_mqueue.o, rp2040-boot2_crc.o, libbedrock_kernel_rp2040.a, libbedrock_hal_rp2040.a, libbedrock_lib_rp2040.a]
    cmds:
      - "${CC} ${M0_LDFLAGS} rp2040-test_mqueue.o rp2040-boot2_crc.o -L. -lbedrock_hal_rp2040 -lbedrock_kernel_rp2040 -lbedrock_lib_rp2040 -lgcc -o ${@}"

  test_sleep_list_rp2040.elf:
    deps: [rp2040-test_sleep_list.o, rp2040-boot2_crc.o, libbedrock_kernel_rp2040.a, libbedrock_hal_rp2040.a, libbedrock_lib_rp2040.a]
    cmds:
      - "${CC} ${M0_LDFLAGS} rp2040-test_sleep_list.o rp2040-boot2_crc.o -L. -lbedrock_hal_rp2040 -lbedrock_kernel_rp2040 -lbedrock_lib_rp2040 -lgcc -o ${@}"

  test_pool_rp2040.elf:
    deps: [rp2040-test_pool.o, rp2040-boot2_crc.o, libbedrock_kernel_rp2040.a, libbedrock_hal_rp2040.a, libbedrock_lib_rp2040.a]
    cmds:
      - "${CC} ${M0_LDFLAGS} rp2040-test_pool.o rp2040-boot2_crc.o -L. -lbedrock_hal_rp2040 -lbedrock_kernel_rp2040 -lbedrock_lib_rp2040 -lgcc -o ${@}"

  bedrock_example_rp2040.uf2:
    deps: [bedrock_example_rp2040.elf, bin2uf2]
    cmds:
      - "${OBJCOPY} -O binary bedrock_example_rp2040.elf bedrock_example_rp2040.bin"
      - "./bin2uf2 bedrock_example_rp2040.bin ${@} 0x10000000 0xe48bff56"

  rp2040:
    deps: [bedrock_example_rp2040.uf2, test_task_delete_rp2040.elf, test_scheduler_rp2040.elf, test_semaphore_rp2040.elf, test_mutex_rp2040.elf, test_mqueue_rp2040.elf, test_sleep_list_rp2040.elf, test_pool_rp2040.elf]

  defconfig-rp2040:
    cmds:
      - "3rd/tools/kconfig/zig-out/bin/defconfig boards/rpi-pico/defconfig"

  stm32f103-br_hal_timer.o:
    cmds:
      - "${CC} ${CFLAGS} -DBR_HAL_SYS_CLOCK_HZ=72000000 arch/arm-cortex-m/br_hal_timer.c -o ${@}"

  stm32f103-br_hal_uart.o:
    cmds:
      - "${CC} ${CFLAGS} boards/stm32f103c8-bluepill/br_hal_uart.c -o ${@}"

  stm32f103-board.o:
    cmds:
      - "${CC} ${CFLAGS} boards/stm32f103c8-bluepill/board.c -o ${@}"

  libbedrock_hal_stm32f103.a:
    deps: [stm32f103-br_hal_timer.o, br_hal_context.o, stm32f103-br_hal_uart.o, startup.o]
    cmds:
      - "${AR} rcs ${@} ${^}"

  bedrock_example_stm32f103.elf:
    deps: [main.o, stm32f103-board.o, libbedrock_hal_stm32f103.a, libbedrock_kernel.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${STM32F1_LDFLAGS} main.o stm32f103-board.o -L. -lbedrock_hal_stm32f103 -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  test_task_delete_stm32f103.elf:
    deps: [test_task_delete.o, stm32f103-board.o, libbedrock_hal_stm32f103.a, libbedrock_kernel.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${STM32F1_LDFLAGS} test_task_delete.o stm32f103-board.o -L. -lbedrock_hal_stm32f103 -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  test_scheduler_stm32f103.elf:
    deps: [test_scheduler.o, stm32f103-board.o, libbedrock_hal_stm32f103.a, libbedrock_kernel.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${STM32F1_LDFLAGS} test_scheduler.o stm32f103-board.o -L. -lbedrock_hal_stm32f103 -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  test_semaphore_stm32f103.elf:
    deps: [test_semaphore.o, stm32f103-board.o, libbedrock_hal_stm32f103.a, libbedrock_kernel.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${STM32F1_LDFLAGS} test_semaphore.o stm32f103-board.o -L. -lbedrock_hal_stm32f103 -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  test_mutex_stm32f103.elf:
    deps: [test_mutex.o, stm32f103-board.o, libbedrock_hal_stm32f103.a, libbedrock_kernel.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${STM32F1_LDFLAGS} test_mutex.o stm32f103-board.o -L. -lbedrock_hal_stm32f103 -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  test_mqueue_stm32f103.elf:
    deps: [test_mqueue.o, stm32f103-board.o, libbedrock_hal_stm32f103.a, libbedrock_kernel.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${STM32F1_LDFLAGS} test_mqueue.o stm32f103-board.o -L. -lbedrock_hal_stm32f103 -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  test_sleep_list_stm32f103.elf:
    deps: [test_sleep_list.o, stm32f103-board.o, libbedrock_hal_stm32f103.a, libbedrock_kernel.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${STM32F1_LDFLAGS} test_sleep_list.o stm32f103-board.o -L. -lbedrock_hal_stm32f103 -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  test_pool_stm32f103.elf:
    deps: [test_pool.o, stm32f103-board.o, libbedrock_hal_stm32f103.a, libbedrock_kernel.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${STM32F1_LDFLAGS} test_pool.o stm32f103-board.o -L. -lbedrock_hal_stm32f103 -lbedrock_kernel -lbedrock_lib -lgcc -o ${@}"

  bedrock_example_stm32f103.bin:
    deps: [bedrock_example_stm32f103.elf]
    cmds:
      - "${OBJCOPY} -O binary bedrock_example_stm32f103.elf ${@}"

  stm32f103:
    deps: [bedrock_example_stm32f103.bin, test_task_delete_stm32f103.elf, test_scheduler_stm32f103.elf, test_semaphore_stm32f103.elf, test_mutex_stm32f103.elf, test_mqueue_stm32f103.elf, test_sleep_list_stm32f103.elf, test_pool_stm32f103.elf]

  defconfig-stm32f103:
    cmds:
      - "3rd/tools/kconfig/zig-out/bin/defconfig boards/stm32f103c8-bluepill/defconfig"

  clean:
    cmds:
      - "rm -f *.o *.a *.elf *.bin *.uf2 rp2040-boot2_crc.S bootcrc bin2uf2"
      - "rm -f bedrock_example_host test_task_delete_host test_scheduler_host test_semaphore_host test_mutex_host test_mqueue_host test_sleep_list_host test_pool_host"
      - "rm -rf include/generated"
