variables:
  CC: "arm-none-eabi-gcc"
  AR: "arm-none-eabi-ar"
  OBJCOPY: "arm-none-eabi-objcopy"
  CFLAGS: "-c -Wall -Wextra -Werror -Os -ffreestanding -ffunction-sections -fdata-sections -std=c11 -mcpu=cortex-m3 -mthumb -mfloat-abi=soft -Iinclude -Ilib -Idrivers"
  LDFLAGS: "-nostdlib -Wl,--gc-sections -Tboards/qemu-cortex-m3/linker.ld -mcpu=cortex-m3 -mthumb"
  HOST_CC: "gcc"
  HOST_CFLAGS: "-c -Wall -Wextra -Werror -Os -std=c11 -D_DEFAULT_SOURCE -DBR_HOST_TEST -Iinclude -Ilib -Idrivers"
  HOST_LDFLAGS: ""
  STM32F1_LDFLAGS: "-nostdlib -Wl,--gc-sections -Tboards/stm32f103c8-bluepill/linker.ld -mcpu=cortex-m3 -mthumb"
  M0_CFLAGS: "-c -Wall -Wextra -Werror -Os -ffreestanding -ffunction-sections -fdata-sections -std=c11 -mcpu=cortex-m0plus -mthumb -mfloat-abi=soft -Iinclude -Ilib -Idrivers"
  M0_LDFLAGS: "-nostdlib -Wl,--gc-sections -Tboards/rpi-pico/linker.ld -mcpu=cortex-m0plus -mthumb"
  TOOL_CFLAGS: "-Wall -Wextra -Werror -Os -std=c11"
  F4_CFLAGS: "-c -Wall -Wextra -Werror -Os -ffreestanding -ffunction-sections -fdata-sections -std=c11 -mcpu=cortex-m4 -mthumb -mfloat-abi=soft -DBR_HAL_SYS_CLOCK_HZ=16000000 -Iinclude -Ilib -Idrivers"
  F4_LDFLAGS: "-nostdlib -Wl,--gc-sections -Tboards/stm32f4-discovery/linker.ld -mcpu=cortex-m4 -mthumb"
  X86_CFLAGS: "-c -Wall -Wextra -Werror -Os -m32 -march=i686 -ffreestanding -fno-pic -fno-pie -fno-stack-protector -fcf-protection=none -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0 -mgeneral-regs-only -ffunction-sections -fdata-sections -std=c11 -Iinclude -Ilib -Idrivers -Iarch/x86"
  X86_LDFLAGS: "-m32 -nostdlib -static -no-pie -Wl,--gc-sections -Wl,-T,boards/qemu-x86/linker.ld -Wl,-m,elf_i386"
  AVR_CC: "avr-gcc"
  AVR_AR: "avr-ar"
  AVR_CFLAGS: "-c -Wall -Wextra -Werror -Os -ffreestanding -ffunction-sections -fdata-sections -std=c11 -mmcu=atmega328p -DBR_HAL_SYS_CLOCK_HZ=16000000UL -Iinclude -Ilib -Idrivers -Iarch/avr -Iexamples"
  AVR_LDFLAGS: "-mmcu=atmega328p -Wl,--gc-sections -Wl,--defsym=__DATA_REGION_LENGTH__=1952"
  RV_CC: "riscv64-elf-gcc"
  RV_AR: "riscv64-elf-ar"
  RV_CFLAGS: "-c -Wall -Wextra -Werror -Os -ffreestanding -ffunction-sections -fdata-sections -std=c11 -march=rv32imac_zicsr -mabi=ilp32 -DBR_HAL_SYS_CLOCK_HZ=10000000 -Iinclude -Ilib -Idrivers"
  RV_LDFLAGS: "-nostdlib -Wl,--gc-sections -Wl,--no-warn-rwx-segments -Tboards/qemu-riscv32-virt/linker.ld -march=rv32imac_zicsr -mabi=ilp32"

targets:
  all:
    deps: [bedrock_example.elf]

  br_sched.o:
    cmds:
      - "${CC} ${CFLAGS} kernel/br_sched.c -o ${@}"

  br_time.o:
    cmds:
      - "${CC} ${CFLAGS} kernel/br_time.c -o ${@}"

  br_task.o:
    cmds:
      - "${CC} ${CFLAGS} kernel/br_task.c -o ${@}"

  br_ipc.o:
    cmds:
      - "${CC} ${CFLAGS} kernel/br_ipc.c -o ${@}"

  br_panic.o:
    cmds:
      - "${CC} ${CFLAGS} kernel/br_panic.c -o ${@}"

  br_uart.o:
    cmds:
      - "${CC} ${CFLAGS} kernel/br_uart.c -o ${@}"

  br_user.o:
    cmds:
      - "${CC} ${CFLAGS} kernel/br_user.c -o ${@}"

  br_usercall.o:
    cmds:
      - "${CC} ${CFLAGS} kernel/br_usercall.c -o ${@}"

  br_device.o:
    cmds:
      - "${CC} ${CFLAGS} kernel/br_device.c -o ${@}"

  br_hal_timer.o:
    cmds:
      - "${CC} ${CFLAGS} arch/arm-cortex-m/br_hal_timer.c -o ${@}"

  br_hal_context.o:
    cmds:
      - "${CC} ${CFLAGS} arch/arm-cortex-m/br_hal_context.c -o ${@}"

  br_hal_fault.o:
    cmds:
      - "${CC} ${CFLAGS} arch/arm-cortex-m/br_hal_fault.c -o ${@}"

  br_hal_mpu.o:
    cmds:
      - "${CC} ${CFLAGS} arch/arm-cortex-m/br_hal_mpu.c -o ${@}"

  br_hal_uart.o:
    cmds:
      - "${CC} ${CFLAGS} boards/qemu-cortex-m3/br_hal_uart.c -o ${@}"

  br_netif_enet.o:
    cmds:
      - "${CC} ${CFLAGS} boards/qemu-cortex-m3/br_netif_enet.c -o ${@}"

  br_hal_gpio.o:
    cmds:
      - "${CC} ${CFLAGS} boards/qemu-cortex-m3/br_hal_gpio.c -o ${@}"

  br_hal_spi.o:
    cmds:
      - "${CC} ${CFLAGS} boards/qemu-cortex-m3/br_hal_spi.c -o ${@}"

  br_hal_i2c.o:
    cmds:
      - "${CC} ${CFLAGS} boards/qemu-cortex-m3/br_hal_i2c.c -o ${@}"

  br_hal_pwm.o:
    cmds:
      - "${CC} ${CFLAGS} boards/qemu-cortex-m3/br_hal_pwm.c -o ${@}"

  startup.o:
    cmds:
      - "${CC} ${CFLAGS} arch/arm-cortex-m/startup.c -o ${@}"

  lm3s-board.o:
    cmds:
      - "${CC} ${CFLAGS} boards/qemu-cortex-m3/board.c -o ${@}"

  br_pool.o:
    cmds:
      - "${CC} ${CFLAGS} lib/br_pool.c -o ${@}"

  br_shell.o:
    cmds:
      - "${CC} ${CFLAGS} lib/br_shell.c -o ${@}"

  br_console.o:
    cmds:
      - "${CC} ${CFLAGS} lib/br_console.c -o ${@}"

  br_shell_cmds.o:
    cmds:
      - "${CC} ${CFLAGS} lib/br_shell_cmds.c -o ${@}"

  br_gpio.o:
    cmds:
      - "${CC} ${CFLAGS} drivers/br_gpio.c -o ${@}"

  br_spi.o:
    cmds:
      - "${CC} ${CFLAGS} drivers/br_spi.c -o ${@}"

  br_i2c.o:
    cmds:
      - "${CC} ${CFLAGS} drivers/br_i2c.c -o ${@}"

  br_pwm.o:
    cmds:
      - "${CC} ${CFLAGS} drivers/br_pwm.c -o ${@}"

  br_capture.o:
    cmds:
      - "${CC} ${CFLAGS} drivers/br_capture.c -o ${@}"

  br_uart_dev.o:
    cmds:
      - "${CC} ${CFLAGS} drivers/br_uart_dev.c -o ${@}"

  br_netif_mock.o:
    cmds:
      - "${CC} ${CFLAGS} drivers/br_netif_mock.c -o ${@}"

  br_fs.o:
    cmds:
      - "${CC} ${CFLAGS} lib/br_fs.c -o ${@}"

  br_ramdisk.o:
    cmds:
      - "${CC} ${CFLAGS} lib/br_ramdisk.c -o ${@}"

  br_shell_fs.o:
    cmds:
      - "${CC} ${CFLAGS} lib/br_shell_fs.c -o ${@}"

  br_string.o:
    cmds:
      - "${CC} ${CFLAGS} -fno-tree-loop-distribute-patterns lib/br_string.c -o ${@}"

  main.o:
    cmds:
      - "${CC} ${CFLAGS} examples/main.c -o ${@}"

  test_task_delete.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_task_delete.c -o ${@}"

  test_scheduler.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_scheduler.c -o ${@}"

  test_semaphore.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_semaphore.c -o ${@}"

  test_mutex.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_mutex.c -o ${@}"

  test_mqueue.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_mqueue.c -o ${@}"

  test_shell.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_shell.c -o ${@}"

  test_uart_rx.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_uart_rx.c -o ${@}"

  test_shell_cmds.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_shell_cmds.c -o ${@}"

  test_pwm.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_pwm.c -o ${@}"

  test_shell_fs.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_shell_fs.c -o ${@}"

  test_fs.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_fs.c -o ${@}"

  lfs.o:
    cmds:
      - "${CC} ${CFLAGS} -w -DLFS_DEFINES=br_lfs_config.h -Iports/littlefs -Iports/littlefs/upstream ports/littlefs/upstream/lfs.c -o ${@}"

  lfs_util.o:
    cmds:
      - "${CC} ${CFLAGS} -w -DLFS_DEFINES=br_lfs_config.h -Iports/littlefs -Iports/littlefs/upstream ports/littlefs/upstream/lfs_util.c -o ${@}"

  br_lfs.o:
    cmds:
      - "${CC} ${CFLAGS} -Iports/littlefs -Iports/littlefs/upstream ports/littlefs/br_lfs.c -o ${@}"

  test_littlefs.o:
    cmds:
      - "${CC} ${CFLAGS} -Iports/littlefs -Iports/littlefs/upstream examples/test_littlefs.c -o ${@}"

  br_libc.o:
    cmds:
      - "${CC} ${CFLAGS} -fno-builtin -fno-tree-loop-distribute-patterns ports/br_libc.c -o ${@}"

  test_i2c.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_i2c.c -o ${@}"

  test_spi.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_spi.c -o ${@}"

  test_gpio.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_gpio.c -o ${@}"

  test_device.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_device.c -o ${@}"

  test_task_info.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_task_info.c -o ${@}"

  test_console.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_console.c -o ${@}"

  test_sleep_list.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_sleep_list.c -o ${@}"

  test_pool.o:
    cmds:
      - "${CC} ${CFLAGS} examples/test_pool.c -o ${@}"

  libbedrock_kernel.a:
    deps: [br_sched.o, br_time.o, br_task.o, br_ipc.o, br_panic.o, br_uart.o, br_device.o, br_user.o, br_usercall.o]
    cmds:
      - "${AR} rcs ${@} ${^}"

  libbedrock_hal.a:
    deps: [br_hal_timer.o, br_hal_context.o, br_hal_uart.o, br_hal_gpio.o, br_hal_spi.o, br_hal_i2c.o, br_hal_pwm.o, br_netif_enet.o, br_hal_fault.o, br_hal_mpu.o, startup.o]
    cmds:
      - "${AR} rcs ${@} ${^}"

  libbedrock_lib.a:
    deps: [br_pool.o, br_string.o, br_shell.o, br_console.o, br_shell_cmds.o, br_gpio.o, br_spi.o, br_i2c.o, br_pwm.o, br_capture.o, br_uart_dev.o, br_fs.o, br_ramdisk.o, br_shell_fs.o, br_netif_mock.o]
    cmds:
      - "${AR} rcs ${@} ${^}"

  bedrock_example.elf:
    deps: [main.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} main.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_task_delete.elf:
    deps: [test_task_delete.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_task_delete.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_scheduler.elf:
    deps: [test_scheduler.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_scheduler.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_semaphore.elf:
    deps: [test_semaphore.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_semaphore.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_mutex.elf:
    deps: [test_mutex.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_mutex.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_mqueue.elf:
    deps: [test_mqueue.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_mqueue.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_shell.elf:
    deps: [test_shell.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_shell.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_uart_rx.elf:
    deps: [test_uart_rx.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_uart_rx.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_shell_cmds.elf:
    deps: [test_shell_cmds.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_shell_cmds.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_pwm.elf:
    deps: [test_pwm.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_pwm.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_shell_fs.elf:
    deps: [test_shell_fs.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_shell_fs.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_fs.elf:
    deps: [test_fs.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_fs.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_littlefs.elf:
    deps: [test_littlefs.o, lfs.o, lfs_util.o, br_lfs.o, br_libc.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_littlefs.o lfs.o lfs_util.o br_lfs.o br_libc.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_i2c.elf:
    deps: [test_i2c.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_i2c.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_spi.elf:
    deps: [test_spi.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_spi.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_gpio.elf:
    deps: [test_gpio.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_gpio.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_device.elf:
    deps: [test_device.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_device.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_task_info.elf:
    deps: [test_task_info.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_task_info.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_console.elf:
    deps: [test_console.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_console.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_sleep_list.elf:
    deps: [test_sleep_list.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_sleep_list.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  test_pool.elf:
    deps: [test_pool.o, libbedrock_kernel.a, lm3s-board.o, libbedrock_hal.a, libbedrock_lib.a]
    cmds:
      - "${CC} ${LDFLAGS} test_pool.o lm3s-board.o -L. -Wl,--start-group -lbedrock_hal -lbedrock_kernel -lbedrock_lib -Wl,--end-group -lgcc -o ${@}"

  run:
    deps: [bedrock_example.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel bedrock_example.elf -nographic"

  test:
    deps: [test_task_delete.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_task_delete.elf -nographic"

  test-scheduler:
    deps: [test_scheduler.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_scheduler.elf -nographic"

  test-semaphore:
    deps: [test_semaphore.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_semaphore.elf -nographic"

  test-mutex:
    deps: [test_mutex.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_mutex.elf -nographic"

  test-mqueue:
    deps: [test_mqueue.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_mqueue.elf -nographic"

  test-shell:
    deps: [test_shell.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_shell.elf -nographic"

  test-uart-rx:
    deps: [test_uart_rx.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_uart_rx.elf -nographic"

  test-shell-cmds:
    deps: [test_shell_cmds.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_shell_cmds.elf -nographic"

  test-pwm:
    deps: [test_pwm.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_pwm.elf -nographic"

  test-shell-fs:
    deps: [test_shell_fs.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_shell_fs.elf -nographic"

  test-fs:
    deps: [test_fs.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_fs.elf -nographic"

  test-littlefs:
    deps: [test_littlefs.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_littlefs.elf -nographic"

  test-i2c:
    deps: [test_i2c.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_i2c.elf -nographic"

  test-spi:
    deps: [test_spi.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_spi.elf -nographic"

  test-gpio:
    deps: [test_gpio.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_gpio.elf -nographic"

  test-device:
    deps: [test_device.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_device.elf -nographic"

  test-task-info:
    deps: [test_task_info.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_task_info.elf -nographic"

  test-console:
    deps: [test_console.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_console.elf -nographic"

  test-sleep-list:
    deps: [test_sleep_list.elf]
    cmds:
      - "qemu-system-arm -M lm3s6965evb -kernel test_sleep_list.elf -nographic"

  test-pool:
