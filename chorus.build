  stm32f103:
    deps: [bedrock_example_stm32f103.bin, test_task_delete_stm32f103.elf, test_scheduler_stm32f103.elf, test_semaphore_stm32f103.elf, test_mutex_stm32f103.elf, test_mqueue_stm32f103.elf, test_sleep_list_stm32f103.elf, test_pool_stm32f103.elf, test_uart_rx_stm32f103.elf, test_shell_stm32f103.elf, test_console_stm32f103.elf, test_task_info_stm32f103.elf, test_shell_cmds_stm32f103.elf, test_device_stm32f103.elf, test_gpio_stm32f103.elf, test_spi_stm32f103.elf, test_i2c_stm32f103.elf, test_pwm_stm32f103.elf, test_fs_stm32f103.elf, test_shell_fs_stm32f103.elf]

  defconfig-stm32f103:
    cmds:
      - "3rd/tools/kconfig/zig-out/bin/defconfig boards/stm32f103c8-bluepill/defconfig"

  clean:
    cmds:
      - "rm -f *.o *.a *.elf *.bin *.uf2 rp2040-boot2_crc.S bootcrc bin2uf2"
      - "rm -f bedrock_example_host test_task_delete_host test_scheduler_host test_semaphore_host test_mutex_host test_mqueue_host test_sleep_list_host test_pool_host test_uart_rx_host test_shell_host test_console_host test_task_info_host test_shell_cmds_host test_device_host test_gpio_host test_spi_host test_i2c_host test_pwm_host test_fs_host test_shell_fs_host"
      - "rm -rf include/generated"
