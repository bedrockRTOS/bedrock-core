path add $rp2040
$machine_name="pico"
$platform_file=$rp2040/boards/raspberry_pico.repl
include $rp2040/cores/initialize_peripherals_source.resc
machine LoadPlatformDescription $platform_file
sysbus LoadELF $rp2040/bootroms/rp2040/b2.elf
sysbus LoadELF $fw
sysbus.cpu0 VectorTableOffset 0x00000000
sysbus.cpu1 VectorTableOffset 0x00000000
sysbus.uart0 CreateFileBackend $out true
emulation RunFor $time
quit
